{
  "manifest_version": 3,
  "name": "Mais Acessível — Importar do Bling",
  "version": "1.1",
  "description": "Importa propostas do Bling direto para o Sistema de Cotação de Frete",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.bling.com.br/*",
    "https://rauldneto.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://www.bling.com.br/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}